# Copy this file to .env and paste your personal MAI key below — the only thing to fill in.
# For the FDE weekend your key arrives by email from Mahalakshmi (it is shown exactly once).
OPENAI_API_KEY=paste-your-mai_-key-here
# (the Practice page calls this MAI_API_KEY — either name works here)
# Preset to the class LLM proxy — leave as is.
OPENAI_BASE_URL=https://learn.modernaipro.com/api/llm/v1
# Who you are inside the customer's estate (the SSO stand-in). One of the users
# in estate/data/identity.json — the labs switch this as the lesson needs it.
ESTATE_USER=agent.priya
